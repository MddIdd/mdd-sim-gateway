[global]
type=global
allow_sending_180_after_183=yes
user_agent={{ user_agent }}

[system]
type=system
timer_t1=2000
; Timer B must be at least 64 * Timer T1. State the effective value explicitly instead of
; making pjproject correct it at every startup and emit a misleading warning.
timer_b=128000

; ================= VoLTE / VoWiFi IMS core transport (over the ePDG tunnel) =================
[volte_ims]
type=transport
protocol=tcp
{% if pcscf_is_v6 %}
bind=[::]:5060
{% else %}
bind=0.0.0.0:5060
{% endif %}
bind_interface=ipsec0
sec_port_c_min=40000
sec_port_c_max=44999
sec_port_s_min=50000
sec_port_s_max=54999
{% if pani %}
p_access_network_info={{ pani }}
{% endif %}
sec_encryption=yes

{% if pcscf %}
[volte_ims]
type=registration
transport=volte_ims
outbound_auth=volte_ims
imei={{ imei }}
{% if access_type %}
accesstype={{ access_type }}
{% endif %}
server_uri=sip:{{ realm }}
client_uri=sip:{{ imsi }}@{{ realm }}
retry_interval=30
fatal_retry_interval=30
max_retries=999999999
expiration=600000
volte=yes
manual_register=yes
endpoint=volte_ims
receive_sms=yes

[volte_ims]
type=endpoint
; Carrier-specific: O2 UK requires ;user=phone on originating telephone-number INVITEs, while
; Telus' SMSC rejects MESSAGE request-URIs carrying it. The control-plane config selects this.
user_eq_phone={{ 'yes' if user_eq_phone else 'no' }}
transport=volte_ims
context=volte_ims
message_context=volte_ims_msg
disallow=all
allow=amr
bw_value=41
outbound_auth=volte_ims
aors=volte_ims
rewrite_contact=yes
from_domain={{ realm }}
from_user={{ msisdn }}
volte=yes
dedicated_bearer_up=yes
100rel=peer_supported
moh_passthrough=yes
direct_media=no
smsc_uri=sip:{{ smsc }}@{{ realm }}
sdp_owner={{ sdp_owner }}
sdp_session={{ sdp_session }}

[volte_ims]
type=auth
auth_type=ims_aka
username={{ imsi }}@{{ realm }}
usim_ami=yes

[volte_ims]
type=aor
contact=sip:{{ imsi }}@{{ realm }}
max_contacts=1

[volte_ims]
type=identify
endpoint=volte_ims
match={{ pcscf }}

[{{ realm }}]
type=resolve
ip={{ pcscf }}
transport=volte_ims

[smsoip.{{ realm }}]
type=resolve
ip={{ pcscf }}
transport=volte_ims
{% endif %}

; ================= Authenticated browser softphone =================
{# The engine runs in a docker bridge container; its private IP (e.g. 172.17.0.2) is NOT
   routable from the browser. Without an external address Asterisk advertises that
   private IP in its Contact + SDP, so a remote MicroSIP sends in-dialog requests (BYE!) to
   an unroutable target and the call never tears down. Advertise the host's reachable address
   (domain wins if set, else the manager-supplied advertise_addr = host LAN IP). #}
{% set local_ext = domain or advertise_addr %}
{% if webrtc_enable %}
; WebRTC (ws) rides on the built-in HTTP server configured in http.conf, reached only through
; the control surface relay. bind is still REQUIRED (transport_apply rejects the object without
; it) even though the actual listener is http.conf's bindaddr; without it the transport object
; is never created and any INVITE on the webrtc endpoint dies with 500
; ("Unable to retrieve PJSIP transport 'transport-ws'").
[transport-ws]
type=transport
protocol=ws
bind=0.0.0.0
{% if local_ext %}
{% if not media_relay %}
external_media_address={{ local_ext }}
{% endif %}
external_signaling_address={{ local_ext }}
{% endif %}
{% endif %}

[endpoint-local](!)
type=endpoint
context=from-local
message_context=msg-from-local
; from_domain gives the From/PAI URI a valid host on the INVITE Asterisk sends to a local client
; (WebRTC softphone). Without it Asterisk defaults the From domain to the container
; HOSTNAME (a docker id like 03e373936eb4), which JsSIP's strict SIP parser rejects ("error parsing
; From header") — it drops the whole INVITE, so newRTCSession never fires and the browser softphone
; shows no incoming-call (Answer/Decline) overlay. The IMS realm is always a valid FQDN.
from_domain={{ realm }}
disallow=all
allow=amr
; No opus here on purpose. codec_opus is not an Asterisk source module — codecs/codecs.xml
; declares it support_level=external, i.e. a prebuilt binary downloaded from Digium, and
; build_tools/download_externals hard-refuses any non-x86 HOST_CPU. On the aarch64 image there
; is therefore no codec_opus.so and no opus entry in `core show translation`. Offering opus
; here was a trap: a browser that only offers opus, or a negotiation that happens to pick it,
; produces a call with no transcoding path to the AMR-only IMS leg — i.e. silent audio.
; ulaw/alaw are what actually carries every WebRTC call today. (res_format_attr_opus.so is
; still loaded so an opus-bearing re-INVITE from the far end parses cleanly instead of erroring.)
allow=ulaw
allow=alaw
rtp_symmetric=yes
force_rport=yes
rewrite_contact=yes
; Never let the WebRTC softphone direct-media with the IMS side:
; the two legs are incompatible (DTLS-SRTP + ulaw/alaw on the client vs plain RTP + AMR on
; the carrier), so Asterisk MUST stay in the media path to bridge/transcode. With direct_media
; left on (the default) Asterisk would try to re-INVITE the two ends to talk directly, which
; can't work → no audio. (volte_ims already has direct_media=no.)
direct_media=no
{% if msisdn %}
callerid=undefined <{{ msisdn }}>
{% endif %}

[auth-local](!)
type=auth
auth_type=userpass

[aor-local](!)
type=aor
max_contacts=3
remove_existing=yes

{% if webrtc_enable %}
[{{ webrtc_user }}](endpoint-local)
auth=auth-{{ webrtc_user }}
aors={{ webrtc_user }}
transport=transport-ws
webrtc=yes
{% if media_relay and media_addr %}
; Relay media mode: RTP binds to the media network address, which only the relay reaches and
; where the engine admits nothing but this RTP range. The IMS leg is not affected: it keeps
; its own transport inside the tunnel.
media_address={{ media_addr }}
bind_rtp_to_media_address=yes
{% endif %}
dtls_auto_generate_cert=yes
[auth-{{ webrtc_user }}](auth-local)
username={{ webrtc_user }}
password={{ webrtc_password }}
[{{ webrtc_user }}](aor-local)
{% endif %}
