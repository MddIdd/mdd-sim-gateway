[general]
rtpstart={{ rtp_start }}
rtpend={{ rtp_end }}
{% if webrtc_enable %}
; WebRTC needs ICE (an RTP-level feature — lives here, not in pjsip.conf). webrtc=yes turns on
; ice_support at the endpoint, but the ICE agent only gathers candidates when icesupport=yes.
; The browser leg's RTP is bound to the media network address (pjsip.conf media_address), so
; that is the only host candidate. The browser reaches it through the TURN relay on the same
; internal network; nothing is published, so there is no host address to rewrite it to and no
; STUN server to ask.
icesupport=yes
{% endif %}
