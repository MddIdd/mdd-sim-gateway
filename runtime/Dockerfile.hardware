ARG BASE_IMAGE=mdd-sim-gateway/control:v1.12.0
FROM ${BASE_IMAGE} AS pcsc-build

ARG PCSC_VERSION=2.3.3
ARG PCSC_SHA256=00b667aa71504ed1d39a48ad377de048c70dbe47229e8c48a3239ab62979c70f
ARG CCID_VERSION=1.6.2
ARG CCID_SHA256=6d5e6a6884090831ed155ee75cbc03aed252bd8158d94f507a94f05ebaba296c
ARG VPCD_VERSION=0.8
ARG VPCD_SHA256=b428c399d5f014a350db0e8e5947ce69392429cc1aebdf3830af3c7f8078b18f
ARG VPCD_SLOTS=4
ARG DEBIAN_MIRROR=
ARG DEBIAN_SECURITY_MIRROR=

COPY patches/ccid/01_hsic_slot_status.patch \
     patches/ccid/02_hsic_malformed_atr.patch \
     patches/ccid/03_scr_prime_reader.patch \
     /tmp/mdd-ccid-patches/

# Build the daemon, patched USB CCID driver and serial VPCD handler in the image.
# DSM receives no PC/SC packages. The final stage receives only pinned runtime
# artifacts, not this compiler toolchain.
RUN if [ -n "${DEBIAN_MIRROR}" ]; then \
        sed -i "s|http://deb.debian.org/debian|${DEBIAN_MIRROR}|g" \
          /etc/apt/sources.list.d/debian.sources; \
      fi \
    && if [ -n "${DEBIAN_SECURITY_MIRROR}" ]; then \
        sed -i "s|http://deb.debian.org/debian-security|${DEBIAN_SECURITY_MIRROR}|g" \
          /etc/apt/sources.list.d/debian.sources; \
      fi \
    && apt-get update && apt-get install -y --no-install-recommends \
        autoconf automake ca-certificates flex gcc help2man libc6-dev libtool \
        libusb-1.0-0-dev make meson ninja-build patch pkg-config wget zlib1g-dev \
    && cd /tmp \
    && wget -qO pcsc.tar.gz "https://github.com/LudovicRousseau/PCSC/archive/refs/tags/${PCSC_VERSION}.tar.gz" \
    && echo "${PCSC_SHA256}  pcsc.tar.gz" | sha256sum -c - \
    && tar xf pcsc.tar.gz && cd "PCSC-${PCSC_VERSION}" \
    && meson setup builddir --prefix=/usr -Dpolkit=false -Dlibsystemd=false \
         -Dlibudev=false -Dlibusb=true \
    && ninja -C builddir && ninja -C builddir install \
    && DESTDIR=/hardware-root ninja -C builddir install \
    && cd /tmp \
    && wget -qO ccid.tar.gz \
       "https://github.com/LudovicRousseau/CCID/archive/refs/tags/${CCID_VERSION}.tar.gz" \
    && echo "${CCID_SHA256}  ccid.tar.gz" | sha256sum -c - \
    && tar xf ccid.tar.gz && cd "CCID-${CCID_VERSION}" \
    && for patch_file in /tmp/mdd-ccid-patches/*.patch; do patch -p1 < "$patch_file"; done \
    && PKG_CONFIG_PATH=/usr/lib64/pkgconfig meson setup builddir --prefix=/usr \
    && ninja -C builddir \
    && DESTDIR=/hardware-root ninja -C builddir install \
    && cd /tmp \
    && wget -qO vsmartcard.tar.gz \
       "https://github.com/frankmorgner/vsmartcard/archive/refs/tags/virtualsmartcard-${VPCD_VERSION}.tar.gz" \
    && echo "${VPCD_SHA256}  vsmartcard.tar.gz" | sha256sum -c - \
    && tar xf vsmartcard.tar.gz \
    && cd "vsmartcard-virtualsmartcard-${VPCD_VERSION}/virtualsmartcard" \
    && autoreconf -vif . >/dev/null 2>&1 \
    && PKG_CONFIG_PATH=/usr/lib64/pkgconfig ./configure \
         --enable-serialconfdir=/etc/reader.conf.d \
         --enable-serialdropdir=/usr/lib/pcsc/drivers/serial \
         --enable-vpcdslots="${VPCD_SLOTS}" --disable-dependency-tracking \
    && make -C src/vpcd \
    && make -C src/ifd-vpcd \
    && make -C src/ifd-vpcd install DESTDIR=/hardware-root \
    && strip --strip-unneeded /hardware-root/usr/lib/pcsc/drivers/serial/libifdvpcd.so \
    && rm -f /hardware-root/etc/reader.conf.d/vpcd \
    && touch "/hardware-root/usr/lib/pcsc/drivers/serial/.mdd-vpcd-slots-${VPCD_SLOTS}"

FROM ${BASE_IMAGE}

ARG DEBIAN_MIRROR=
ARG DEBIAN_SECURITY_MIRROR=
ARG MDD_VERSION=dev

WORKDIR /app
COPY --from=pcsc-build /hardware-root/ /
COPY runtime/hardware.py /app/runtime/hardware.py
COPY host/vpcd_modem_bridge.py /app/host/vpcd_modem_bridge.py
RUN if [ -n "${DEBIAN_MIRROR}" ]; then \
        sed -i "s|http://deb.debian.org/debian|${DEBIAN_MIRROR}|g" \
          /etc/apt/sources.list.d/debian.sources; \
      fi \
    && if [ -n "${DEBIAN_SECURITY_MIRROR}" ]; then \
        sed -i "s|http://deb.debian.org/debian-security|${DEBIAN_SECURITY_MIRROR}|g" \
          /etc/apt/sources.list.d/debian.sources; \
      fi \
    && apt-get update && apt-get install -y --no-install-recommends \
        network-manager mobile-broadband-provider-info iproute2 libusb-1.0-0 \
    && rm -rf /var/lib/apt/lists/* \
    && printf '/usr/lib64\n' > /etc/ld.so.conf.d/mdd-pcsc.conf \
    && ldconfig \
    && mkdir -p /etc/NetworkManager/conf.d \
    && printf '%s\n' \
        '[main]' \
        'plugins=keyfile' \
        'dns=none' \
        'rc-manager=unmanaged' \
        'no-auto-default=*' \
        '' \
        '[keyfile]' \
        'unmanaged-devices=*,except:interface-name:wwan*;except:interface-name:cdc-wdm*' \
        > /etc/NetworkManager/conf.d/90-mdd-cellular-only.conf

LABEL io.mdd-sim-gateway.component="hardware" \
      io.mdd-sim-gateway.managed="true" \
      org.opencontainers.image.version="${MDD_VERSION}" \
      org.opencontainers.image.title="MDD Sim Gateway hardware plane"

# A start that inherits a stale QMI session resets the modem and waits for it to
# re-enumerate (about 80s on a DS1621+ with an EC25). Failures during the start
# period do not count and the first success ends it, so a generous value costs a
# fast start nothing.
# Each check is a docker exec that starts a fresh Python: on a Raspberry Pi the three
# containers' checks cost about a fifth of a core at 10 s. The first check now comes
# 30 s after start. --start-interval would keep starts fast, but Docker before 25
# rejects it at build time, and install.sh builds this image with the host's Docker.
HEALTHCHECK --interval=30s --timeout=3s --start-period=180s --retries=3 \
    CMD python -c 'import json,time; d=json.load(open("/run/mdd-hardware/status.json")); assert d["version"]==1 and time.time()-d["updated_at"]<15 and "reconcile_error" not in d and d["modem_count"]==d["hardware_count"] and d["ready_bridge_count"]+d.get("maintenance_bridge_count",0)+d.get("card_failed_bridge_count",0)>=d["hardware_count"]'

ENTRYPOINT ["python", "-m", "runtime.hardware"]
